APP_NAME="AliStack Learner"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=alistack_learner
DB_USER=root
DB_PASS=

# AgentRouter AI Tutor
# Enter your supplied AgentRouter API key below
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1/chat/completions
AGENTROUTER_MODEL=gpt-4o-mini
AGENTROUTER_TEMPERATURE=0.7
AGENTROUTER_MAX_TOKENS=1000

# Security & Sessions
SESSION_LIFETIME=604800
CSRF_SECRET=alistack_learner_secret_key_change_in_production
